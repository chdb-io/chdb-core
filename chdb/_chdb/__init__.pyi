import enum
from typing import Any, Callable, Mapping, Optional, Sequence, Union

from . import _sqltypes as _sqltypes
from ._sqltypes import ChdbType

class NullHandling(enum.Enum):
    SKIP: int    # Do not call UDF for NULL inputs, return NULL directly (default)
    PASS: int    # Convert NULL to None and call the UDF

class ExceptionHandling(enum.Enum):
    PROPAGATE: int  # Raise the exception (default)
    IGNORE: int     # Return NULL for the row and continue

class UDFType(enum.Enum):
    NATIVE: int  # Call the UDF once per row with Python values (default)
    ARROW: int   # Call the UDF once per block with one pyarrow.ChunkedArray per argument

def create_function(
    name: str,
    func: Callable[..., object],
    arg_types: Optional[Sequence[Union[ChdbType, str, type]]] = None,
    return_type: Optional[Union[ChdbType, str, type]] = None,
    *,
    on_null: Optional[Union[NullHandling, str]] = None,
    on_error: Optional[Union[ExceptionHandling, str]] = None,
    type: Optional[Union[UDFType, str]] = None,
) -> None: ...

def drop_function(name: str) -> None: ...

def create_aggregate_function(
    name: str,
    accumulator: Callable[[], object],
    arg_types: Optional[Sequence[Union[ChdbType, str, type]]] = None,
    return_type: Optional[Union[ChdbType, str, type]] = None,
    *,
    on_null: Optional[Union[NullHandling, str]] = None,
    on_error: Optional[Union[ExceptionHandling, str]] = None,
) -> None: ...

def drop_aggregate_function(name: str) -> None: ...

class query_result:
    def data(self) -> str: ...
    def bytes(self) -> bytes: ...
    def size(self) -> int: ...
    def rows_read(self) -> int: ...
    def bytes_read(self) -> int: ...
    def storage_rows_read(self) -> int: ...
    def storage_bytes_read(self) -> int: ...
    def rows_written(self) -> int: ...
    def bytes_written(self) -> int: ...
    def elapsed(self) -> float: ...
    def has_error(self) -> bool: ...
    def error_code(self) -> int: ...
    def error_message(self) -> str: ...

class streaming_query_result:
    def has_error(self) -> bool: ...
    def error_code(self) -> int: ...
    def error_message(self) -> str: ...

class cursor:
    def execute(self, query_str: str) -> None: ...
    def commit(self) -> None: ...
    def close(self) -> None: ...
    def interrupt(self) -> None: ...
    def data_size(self) -> int: ...
    def rows_read(self) -> int: ...
    def bytes_read(self) -> int: ...
    def storage_rows_read(self) -> int: ...
    def storage_bytes_read(self) -> int: ...
    def elapsed(self) -> float: ...
    def has_error(self) -> bool: ...
    def error_code(self) -> int: ...
    def error_message(self) -> str: ...

class Database:
    def __init__(self, path: str = ":memory:", *, read_only: bool = False) -> None: ...
    @property
    def path(self) -> str: ...
    def is_open(self) -> bool: ...
    def connect(self, options: str = "", *, read_only: bool = False) -> connect: ...
    def close(self) -> None: ...
    def __enter__(self) -> Database: ...
    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None: ...

def open(path: str = ":memory:", *, read_only: bool = False) -> Database: ...

class connect:
    def __init__(self, path: str = ":memory:") -> None: ...
    def cursor(self) -> cursor: ...
    def commit(self) -> None: ...
    def close(self) -> None: ...
    def interrupt(self) -> None: ...
    def register(self, name: str, obj: Any) -> None: ...
    def unregister(self, name: str) -> None: ...
    def set_progress_callback(self, callback: Optional[Callable[[dict[str, int]], Any]] = None) -> None: ...
    def query(
        self,
        query_str: str,
        format: str = "CSV",
        *,
        params: Optional[Mapping[str, Any]] = None,
        tables: Optional[Mapping[str, Any]] = None,
    ) -> query_result: ...
    def query_df(
        self,
        query_str: str,
        *,
        params: Optional[Mapping[str, Any]] = None,
        tables: Optional[Mapping[str, Any]] = None,
    ) -> Any: ...
    def query_arrow_reader(
        self,
        query_str: str,
        *,
        params: Optional[Mapping[str, Any]] = None,
        options: Optional[Mapping[str, bool]] = None,
        tables: Optional[Mapping[str, Any]] = None,
    ) -> Any: ...
    def send_query_arrow(
        self,
        query_str: str,
        *,
        params: Optional[Mapping[str, Any]] = None,
        options: Optional[Mapping[str, bool]] = None,
        tables: Optional[Mapping[str, Any]] = None,
    ) -> streaming_query_result: ...
    def streaming_fetch_arrow(self, streaming_result: streaming_query_result) -> Any: ...
    def send_query(
        self,
        query_str: str,
        format: str = "CSV",
        *,
        params: Optional[Mapping[str, Any]] = None,
        tables: Optional[Mapping[str, Any]] = None,
    ) -> streaming_query_result: ...
    def streaming_fetch_result(self, streaming_result: streaming_query_result) -> Optional[query_result]: ...
    def streaming_fetch_df(self, streaming_result: streaming_query_result) -> Any: ...
    def streaming_cancel_query(self, streaming_result: streaming_query_result) -> None: ...

