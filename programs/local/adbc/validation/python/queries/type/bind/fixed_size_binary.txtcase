sort-keys = [["res", "ascending"]]

[setup]
drop = "test_fixed_size_binary"

[tags]
sql-type-name = "VARBINARY"

// part: setup_query

CREATE TABLE test_fixed_size_binary (
    res Nullable(String)
);

// part: bind_query

INSERT INTO test_fixed_size_binary VALUES ($1)

// part: bind_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "w:15",
            "flags": ["nullable"]
        }
    ]
}

// part: bind

{"res": "AAAAAAAAAAAAAAAAAAAA"}
{"res": "AAECAwQFBgcICQoLDA0O"}
{"res": "DxAREhMUFRYXGBkaGxwd"}
{"res": "YmluLTAzLWJpbi0wMy1i"}
{"res": "YmluLTA0LWJpbi0wNC1i"}
{"res": null}

// part: query

SELECT res FROM test_fixed_size_binary ORDER BY res

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "u",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": ""}
{"res": "\u0000\u0001\u0002\u0003\u0004\u0005\u0006\u0007\b\t\n\u000b\f\r\u000e"}
{"res": "\u000f\u0010\u0011\u0012\u0013\u0014\u0015\u0016\u0017\u0018\u0019\u001a\u001b\u001c\u001d"}
{"res": "bin-03-bin-03-b"}
{"res": "bin-04-bin-04-b"}
{"res": null}
