{
  "name": "chdb-wasm",
  "version": "0.2.0",
  "description": "chdb (ClickHouse) compiled to WebAssembly, with an async, non-blocking, worker-based API",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chdb-io/chdb-core.git",
    "directory": "packages/chdb-wasm"
  },
  "homepage": "https://github.com/chdb-io/chdb-core/tree/main/packages/chdb-wasm#readme",
  "bugs": {
    "url": "https://github.com/chdb-io/chdb-core/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": "./dist/worker.js",
    "./chdb.wasm": "./dist/chdb.wasm"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-artifacts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:node": "node test/smoke.test.mjs",
    "test:matrix": "node test/matrix.test.mjs",
    "test:browser": "node test/browser-run.mjs"
  },
  "keywords": [
    "clickhouse",
    "chdb",
    "wasm",
    "webassembly",
    "sql",
    "olap",
    "database"
  ],
  "devDependencies": {
    "@types/node": "^22.19.19",
    "puppeteer": "^25.1.0",
    "typescript": "^5.7.2"
  }
}
