{
  "name": "chdb-cloudflare",
  "version": "0.1.0",
  "description": "chdb (ClickHouse) for Cloudflare Workers — a single size-capped WebAssembly bundle with a JSPI async-fetch HTTP bridge, so url()/s3() work inside Workers. Covers the most common SQL surface; for full SQL coverage use the chdb-wasm package.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./worker": "./dist/worker.js",
    "./workers": {
      "types": "./dist/workers.d.ts",
      "import": "./dist/workers.js",
      "default": "./dist/workers.js"
    },
    "./chdb.wasm": "./dist/chdb.wasm",
    "./chdb.mjs": "./dist/chdb.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=23"
  },
  "scripts": {
    "build": "node scripts/build-lite.mjs",
    "test": "node test/lite.test.mjs"
  },
  "keywords": [
    "clickhouse",
    "chdb",
    "wasm",
    "webassembly",
    "sql",
    "olap",
    "cloudflare-workers"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chdb-io/chdb-core.git",
    "directory": "packages/chdb-cloudflare"
  }
}
